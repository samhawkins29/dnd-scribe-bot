# ═══════════════════════════════════════════════════
#  D&D Scribe Bot — Environment Variables
#  Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════

# ─── Discord ──────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
# Optional: restrict slash commands to a specific server (faster registration)
DISCORD_GUILD_ID=

# Per-guild state isolation: each Discord server gets its own campaign context,
# speaker map, campaign log, and chapter numbering under lore/guilds/<id>/ and
# stories/guilds/<id>/. Set PRIMARY_GUILD_ID to your main server's id to keep
# THAT server's data in the original flat layout (lore/*.json, stories/*) so an
# existing single-campaign install is untouched. Leave empty if you only run one.
PRIMARY_GUILD_ID=

# ─── Anthropic (Claude) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192
# Output budget for whole-transcript passes (classifier/corrector). Large enough
# that a multi-hour session isn't truncated mid-response.
ANTHROPIC_TRANSCRIPT_MAX_TOKENS=32768

# ─── Cost controls ───────────────────────────────
# Hard ceiling (USD) for a single story generation incl. all verification
# regenerations + verifier calls. The loop stops and keeps the best story once
# the next attempt would exceed this. Set to 0 to disable.
STORY_MAX_USD=5

# ─── Transcription reliability ───────────────────
# Wall-clock cap (ms) on the AssemblyAI poll loop so a stuck cloud job can't
# hang the pipeline and brick the per-guild processing lock. Default 45 min.
ASSEMBLYAI_POLL_TIMEOUT_MS=2700000

# ─── Transcription Service ───────────────────────
# Options: whisper-local | assemblyai | deepgram
TRANSCRIPTION_SERVICE=whisper-local

# ─── Whisper (local, free) ───────────────────────
WHISPER_BINARY=whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
# If using whisper.cpp, set the path to the .bin model file:
WHISPER_CPP_MODEL=

# ─── AssemblyAI (cloud, speaker diarization) ─────
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ─── Deepgram (cloud, fast diarization) ──────────
DEEPGRAM_API_KEY=your_deepgram_key_here

# ─── Story Style ─────────────────────────────────
# Options: martin | sanderson
DEFAULT_STYLE=martin

# Story creativity level: strict | balanced | creative | transcript-only (default)
# transcript-only: narrates only transcript events, allows minor atmospheric transitions
# and character reactions but no invented scenes, characters, or dialogue
STORY_CREATIVITY=transcript-only

# ─── Cross-Session Learning ─────────────────────
# The bot automatically learns from verification results across sessions.
# After each story is verified, fabrications and omissions are saved to
# stories/verification-history.json. On subsequent runs, the last 5 sessions'
# patterns are analyzed and injected into the prompt so the model avoids
# repeating the same types of mistakes (e.g., inventing atmospheric details,
# misidentifying speakers). No configuration needed — this is automatic.

# ─── Recap Channel ───────────────────────────────
# Channel name to auto-post stories to (case-insensitive partial match)
RECAP_CHANNEL_NAME=recap

# ─── Audio ───────────────────────────────────────
# Options: ogg | pcm
AUDIO_FORMAT=ogg
FFMPEG_PATH=ffmpeg

# ─── Privacy / data handling (see PRIVACY.md) ────
# Delete the raw recording from recordings/ after a fully successful pipeline
# run (the backups/ copy is kept). The failure path never deletes audio.
DELETE_AUDIO_AFTER_PROCESSING=false
# Intended retention window (days) for raw recordings; 0 = keep forever.
AUDIO_RETENTION_DAYS=0

# ─── Logging ─────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info

# ─── Dashboard ───────────────────────────────────
# Shared secret for the web control panel. When set, every dashboard request
# (and socket connection) requires it via HTTP Basic auth (password = token),
# a Bearer token, or ?token=. LEAVE EMPTY ONLY for local use — when unset the
# dashboard refuses to bind anywhere but loopback and logs a warning.
DASHBOARD_TOKEN=
# Interface to bind the dashboard to. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to expose it — only do this together with DASHBOARD_TOKEN.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
